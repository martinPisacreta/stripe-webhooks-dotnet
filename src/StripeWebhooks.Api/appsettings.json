{
  "ConnectionStrings": {
    "Payments": "Data Source=payments.db"
  },
  "Stripe": {
    "SignatureToleranceSeconds": 300,
    "QueueCapacity": 1000,
    "SweepInterval": "00:00:30",
    "MaxAttempts": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
